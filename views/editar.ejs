<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
</head>
<body>
    <%- include('partials/header') %>

    <h2>Editar jogo</h2>
    <form class="game-form edit-form" action="/jogos/editar/<%= jogo.id %>" method="POST">
        <div>
            <label for="titulo">Título:</label>
            <input id="titulo" type="text" name="titulo" value="<%= jogo.titulo %>" required>
        </div>
        <div>
            <label for="plataforma">Plataforma:</label>
            <input id="plataforma" type="text" name="plataforma" value="<%= jogo.plataforma %>" required>
        </div>
        <div>
            <label for="status">Status:</label>
            <select id="status" name="status">
                <option value="Quero jogar" <%= jogo.status === 'Quero jogar' ? 'selected' : '' %>>Quero jogar</option>
                <option value="Jogando" <%= jogo.status === 'Jogando' ? 'selected' : '' %>>Jogando</option>
                <option value="Zerado" <%= jogo.status === 'Zerado' ? 'selected' : '' %>>Zerado</option>
            </select>
        </div>
        <div>
            <label for="nota">Nota:</label>
            <input id="nota" type="number" step="0.1" name="nota" value="<%= jogo.nota ?? '' %>" min="0" max="10">
        </div>
        <button class="btn btn-primary" type="submit">Salvar alterações</button>
        <a class="btn btn-secondary" href="/jogos">Cancelar</a>
    </form>

    <%- include('partials/footer') %>
</body>
</html>
